DISCORD_TOKEN=your_discord_bot_token_here

# Public Google Apps Script web app URL ending in /exec.
GAS_CONFIG_URL=https://script.google.com/macros/s/replace_with_deployment_id/exec

# These IDs are loaded from GAS on each restart.
GAS_BOOTSTRAP_OWNER_ID=replace_with_discord_id
UPDATE_BRANCH=master
